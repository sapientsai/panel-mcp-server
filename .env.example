OPENROUTER_API_KEY=sk-or-your-key-here

# Optional direct-provider keys. When set, the matching models are called
# directly instead of routing through OpenRouter.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# MISTRAL_API_KEY=...

# Azure OpenAI / Microsoft Foundry. Both are required together; the base URL
# must end in /openai/v1/. Model strings are DEPLOYMENT names, not model ids,
# so azure/gpt-6-astra targets a deployment literally named "gpt-6-astra".
# AZURE_API_KEY=...
# AZURE_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/

# Default panel when PANEL_DEFAULT_MODELS is unset (paid, direct providers):
#   openai/gpt-5.6-sol,anthropic/claude-sonnet-5,google/gemini-3.1-pro-preview

# Opt in to the free router instead (auto-selects from available free models).
# Comment this out to fall back to the paid defaults above.
PANEL_DEFAULT_MODELS=openrouter/openrouter/free
